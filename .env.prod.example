# Образец продового окружения BScout.
# Скопируйте в .env.prod и заполните. Файл с реальными значениями НЕ коммитить.
#
# Переменные без значения по умолчанию обязательны: compose откажется стартовать
# без них — это сделано намеренно, чтобы секрет нельзя было забыть.

# ── Домен и TLS ───────────────────────────────────────────────────────────────
SERVER_NAME=bscout.ru
FRONTEND_BASE_URL=https://bscout.ru
# Каталог на хосте с сертификатами и пути внутри контейнера nginx
TLS_CERT_DIR=/etc/letsencrypt/live/bscout.ru
TLS_CERT_PATH=/etc/nginx/certs/fullchain.pem
TLS_KEY_PATH=/etc/nginx/certs/privkey.pem
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
# Максимальный размер тела запроса (аудит отметил его отсутствие)
CLIENT_MAX_BODY_SIZE=2m

# ── Приложение ────────────────────────────────────────────────────────────────
APP_NAME=BScout API
IMAGE_TAG=latest
# ⚠️ DEBUG=false обязателен в проде: иначе открыт Swagger и ослаблена проверка секрета
DEBUG=false
LOG_LEVEL=INFO
# Домены, которым браузер разрешит обращаться к API (через запятую)
CORS_ORIGINS_RAW=https://bscout.ru
UVICORN_WORKERS=2

# ── База данных ───────────────────────────────────────────────────────────────
POSTGRES_DB=bscout
POSTGRES_USER=bscout
# ⚠️ Задайте длинный случайный пароль
POSTGRES_PASSWORD=
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB

# ── Redis ─────────────────────────────────────────────────────────────────────
# Хранит счётчики лимитов и список отозванных токенов — пароль обязателен
REDIS_PASSWORD=
REDIS_MAXMEMORY=256mb

# ── JWT ───────────────────────────────────────────────────────────────────────
# ⚠️ Случайная строка не короче 32 символов. С дефолтным значением и DEBUG=false
# приложение намеренно откажется стартовать: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Лимиты запросов ───────────────────────────────────────────────────────────
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW=60
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW=300
# ⚠️ true допустимо ТОЛЬКО за доверенным обратным прокси: иначе лимит обходится
# подделкой заголовка X-Forwarded-For
RATE_LIMIT_TRUST_FORWARDED_FOR=true
FORWARDED_ALLOW_IPS=*

# ── Почта ─────────────────────────────────────────────────────────────────────
# console — письма только в лог; smtp — реальная отправка
MAIL_BACKEND=smtp
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BScout <no-reply@bscout.ru>

# ── Платежи ───────────────────────────────────────────────────────────────────
# ⚠️ Пока не задан, вебхук отвечает 503 — это защита от открытого вебхука.
# ⚠️ Перед подключением мерчанта заменить заглушку подписи в
# src/modules/payment/controller/payment.py на алгоритм провайдера.
YOOKASSA_WEBHOOK_SECRET=

# ── Вход через ВКонтакте ──────────────────────────────────────────────────────
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=https://bscout.ru/auth/vk/callback

# ── Телеграм (канал уведомлений о снижении цены, не способ входа) ─────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Включать только после ограниченной проверки всех парсеров на production-сети.
PARSER_FULL_SYNC_ENABLED=false
