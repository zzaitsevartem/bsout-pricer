# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bscout
POSTGRES_USER=bscout
POSTGRES_PASSWORD=bscout
DATABASE_URL=postgresql+asyncpg://bscout:bscout@localhost:5432/bscout

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# App
DEBUG=true
APP_NAME=BScout API

# Уведомления ЮKassa проверяются повторным запросом объекта платежа в API
# провайдера (своей подписи у уведомлений нет), поэтому отдельного секрета
# вебхука нет. Пока не заданы реквизиты мерчанта, subscribe работает в ручном
# режиме (provider=manual), а POST /api/payment/webhook отвечает 503.
# Реквизиты: https://yookassa.ru.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Публичный адрес фронта — используется в ссылках писем.
# ⚠️ Ссылки НИКОГДА не строятся из заголовка Host: иначе подделка Host даёт фишинговую ссылку.
FRONTEND_BASE_URL=http://localhost:3000
# Куда уходят сообщения с формы контактов (/contacts).
SUPPORT_EMAIL=support@bscout.ru

# Почта. mail_backend: console (по умолчанию, письма в лог) | smtp
#
# SMTP через Яндекс (smtp.yandex.ru).
# SMTP_USER — полный адрес почты, например my.login@yandex.ru.
# SMTP_PASSWORD — НЕ основной пароль от почты, а пароль приложения:
#   https://id.yandex.ru/security/app-passwords (для этого в настройках должна
#   быть включена двухфакторная аутентификация).
# Порт 465 — SMTP с SSL (самый надёжный для Яндекса). Альтернатива: 587/TLS.
# SMTP_FROM должен использовать адрес, привязанный к SMTP_USER.
MAIL_BACKEND=smtp
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_FROM=BScout.Pricer - платформа для поиска и сравнения цен <bscout.pricer@yandex.ru>

# Вход через ВКонтакте. VK_REDIRECT_URI должен вести на страницу колбэка фронта
# (frontend/src/app/auth/vk/callback) и совпадать с настройками VK-приложения.
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=http://localhost:3000/auth/vk/callback

# Телеграм — канал уведомлений о снижении цены (не способ входа)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Full nightly catalog crawl. Keep disabled until live parser verification is complete.
PARSER_FULL_SYNC_ENABLED=false
