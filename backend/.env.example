# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bscout
POSTGRES_USER=bscout
POSTGRES_PASSWORD=bscout
DATABASE_URL=postgresql+asyncpg://bscout:bscout@localhost:5432/bscout

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# App
DEBUG=true
APP_NAME=BScout API

# Секрет подписи вебхука платёжного провайдера.
# Пока не задан, POST /api/payment/webhook отвечает 503 — открытый вебхук раздавал бы подписки даром.
YOOKASSA_WEBHOOK_SECRET=

# Публичный адрес фронта — используется в ссылках писем.
# ⚠️ Ссылки НИКОГДА не строятся из заголовка Host: иначе подделка Host даёт фишинговую ссылку.
FRONTEND_BASE_URL=http://localhost:3000

# Почта. mail_backend: console (по умолчанию, письма в лог) | smtp
MAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_FROM=BScout <no-reply@bscout.ru>

# Вход через ВКонтакте
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=

# Телеграм — канал уведомлений о снижении цены (не способ входа)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Full nightly catalog crawl. Keep disabled until live parser verification is complete.
PARSER_FULL_SYNC_ENABLED=false
