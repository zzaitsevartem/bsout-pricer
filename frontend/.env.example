BACKEND_URL=http://localhost:8000

# Абсолютный адрес сайта. Используется для metadataBase, robots.txt и
# sitemap.xml: без него Next не может превратить относительные ссылки
# (og:image, url в карте сайта) в абсолютные.
# В проде это build.args сервиса frontend (docker-compose.prod.yml),
# потому что значение попадает в сборку, а не в рантайм.
FRONTEND_BASE_URL=http://localhost:3000
