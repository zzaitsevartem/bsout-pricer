{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm install)",
      "Bash(npx prettier *)",
      "Bash(npx eslint *)",
      "Bash(poetry install)",
      "Bash(poetry run *)",
      "Bash(uvicorn *)",
      "Bash(alembic *)",
      "Bash(ruff *)",
      "Bash(docker compose *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(bash scripts/plan/*)",
      "Bash(scripts/plan/*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Write(**/.env)",
      "Write(**/.env.local)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/plan-status-inject.sh",
            "statusMessage": "Загрузка статуса плана (docs/plan)..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-secrets.sh",
            "statusMessage": "Проверка на доступ к секретам..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/frontend-format.sh",
            "statusMessage": "prettier + eslint --fix (frontend)..."
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/backend-format.sh",
            "statusMessage": "ruff format/check (backend)..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/build-lint-reminder.sh"
          }
        ]
      }
    ]
  }
}
